{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Preparar o ambiente",
            "detail": "Confere o WSL, o uv e o git e instala as dependências do desenvolvimento",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/dev/setup.ps1"
            ],
            "icon": {
                "id": "tools",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Documentação: site completo",
            "detail": "Gera a documentação nos dois idiomas e serve o site como o GitHub Pages (sem hot reload)",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/dev/docs.ps1"
            ],
            "icon": {
                "id": "book",
                "color": "terminal.ansiCyan"
            },
            "presentation": {
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
